# hammerOS kernel config — 0.1 core (lean, built-in-only, no modules)
# Base principle: nothing enters the kernel unless it boots the system or
# talks to VM + generic PC hardware. Tinyconfig-style starting point with
# explicit enables; `make olddefconfig` resolves the rest.

# ---- base ----------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_SYSCTL=y
CONFIG_POSIX_TIMERS=y

# ---- reboot / kernel boot surface ----------------------------------------
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# ---- storage -------------------------------------------------------------
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_LOOP=y

# ---- filesystems ---------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y

# ---- console / framebuffer -----------------------------------------------
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- networking ----------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y

# ---- input / USB ---------------------------------------------------------
CONFIG_INPUT=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
