#!/bin/sh
# hammerwm — hammerOS framebuffer desktop shell (0.2)
# Pure-ANSI TUI: no ncurses, no dialog. ash + VT escapes only.
# tty1 = this menu. Alt+F2 = raw shell. Mouse works inside links.

export HOME=/root PATH=/bin:/usr/bin TERM=linux
H=24; W=72

scr() { printf '\033[2J\033[H'; }
at() { printf '\033[%s;%sH' "$1" "$2"; }
inv() { printf '\033[7m'; }
norm() { printf '\033[0m'; }
bold() { printf '\033[1m'; }
dim() { printf '\033[2m'; }

mem() { awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%.0f/%.0f MB",(t-a)/1024,t/1024}' /proc/meminfo; }
myip() { ip -o -4 addr show scope global 2>/dev/null | awk '{print $4; exit}'; }

# read a key: echoes up/down/enter/q/other (arrows arrive as ESC [ A/B)
readkey() {
    local k rest
    IFS= read -rsn1 k 2>/dev/null
    [ -z "$k" ] && { echo enter; return; }
    if [ "$k" = "$(printf '\033')" ]; then
        IFS= read -rsn2 -t 1 rest 2>/dev/null
        case "$rest" in
            "[A") echo up; return;; "[B") echo down; return;;
        esac
        echo other; return
    fi
    echo "$k"
}

# menu <title> <subtitle> <item|desc>...   -> sets REPLY_IDX (0-based) or -1
menu() {
    local title="$1" sub="$2" sel=0 n pair k
    shift 2
    local total=$#
    [ $total -eq 0 ] && { REPLY_IDX=-1; return; }
    while :; do
        scr
        at 1 1; bold; printf ' hammerOS 0.2 "Forge" '; norm
        at 2 $((W-26)); printf '%s ram · %s' "$(mem)" "$(myip)"; norm
        at 4 2; bold; printf ' %s ' "$title"; norm
        at 5 2; dim; printf '%s' "$sub"; norm
        n=0
        for pair in "$@"; do
            at $((7+n)) 4
            if [ $n -eq $sel ]; then
                inv; printf ' %-10s' "${pair%%|*}"; norm
                at $((7+n)) 18; printf '%s' "${pair#*|}"
            else
                printf '%-10s' "${pair%%|*}"
                at $((7+n)) 18; dim; printf '%s' "${pair#*|}"; norm
            fi
            n=$((n+1))
        done
        at $((7+n+1)) 2; dim; printf 'up/down select · enter run · q back'; norm
        k=$(readkey)
        case "$k" in
            up)    sel=$((sel-1)); [ $sel -lt 0 ] && sel=$((total-1));;
            down)  sel=$((sel+1)); [ $sel -ge $total ] && sel=0;;
            q)     REPLY_IDX=-1; return;;
            enter) REPLY_IDX=$sel; return;;
        esac
    done
}

pause() { at $((H-1)) 2; printf 'press enter…'; IFS= read -r _; }

showtext() {
    scr; at 1 1; bold; printf ' %s ' "$1"; norm
    sed -n "1,$((H-2))p" "$1"; pause
}

runinfo() {
    scr
    at 1 1; bold; printf ' %s ' "$1"; norm
    eval "$2" 2>&1 | sed -n "1,$((H-2))p"
    pause
}

files() {
    local d=${1:-/} items i pick name p
    while :; do
        items=""
        for x in "$d"/*; do
            [ -e "$x" ] || continue
            n=${x##*/}
            if [ -d "$x" ]; then items="$items$sep$n/|[dir]"
            else items="$items$sep$n|[$(( $(wc -c <"$x" 2>/dev/null || echo 0) / 1024 ))K]"; fi
            sep='
'
        done
        [ -n "$items" ] || { set -- "..|[up]"; }
        if [ -n "$items" ]; then
            oldIFS=$IFS; IFS='
'
            set -- "..|[up]" $items
            IFS=$oldIFS
        fi
        menu "files: $d" "browse" "$@"
        [ "$REPLY_IDX" = -1 ] && return
        i=0; pick=""
        for p in "$@"; do [ $i = "$REPLY_IDX" ] && { pick=$p; break; }; i=$((i+1)); done
        name=${pick%%|*}
        [ "$name" = ".." ] && { d=$(dirname "$d"); continue; }
        case "$name" in */) d="${d%/}/${name%/}"; continue;; esac
        p="${d%/}/$name"
        menu "$name" "$p" "view|[textbox]" "edit|[vi]" "run|[execute]" "back|[]"
        case "$REPLY_IDX" in
            0) showtext "$p";;
            1) vi "$p";;
            2) [ -x "$p" ] && "$p"; pause;;
        esac
    done
}

while :; do
    menu " hammer " "welcome — pick a tool" \
        "Web|graphical browser (links)" \
        "Files|browse / edit / run" \
        "Editor|vi — system editor" \
        "Terminal|plain root shell" \
        "Network|ip · routes · dhcp renew" \
        "System|kernel · memory · cpu" \
        "Reboot|restart hammerOS" \
        "Poweroff|shut down"
    case "$REPLY_IDX" in
        0) scr; links ;;
        1) files ;;
        2) scr; vi ;;
        3) scr; echo "hammerOS shell — exit returns to the menu"; sh ;;
        4) runinfo "network" "ip -o addr show scope global; echo; ip route; echo; cat /etc/resolv.conf" ;;
        5) runinfo "system" "uname -a; echo; . /etc/os-release; echo \$PRETTY_NAME; echo; mem; grep -m1 'model name' /proc/cpuinfo; echo cores: \$(nproc)" ;;
        6) reboot ;;
        7) poweroff ;;
    esac
done
