# hammerOS busybox config — all applets on (defconfig), built STATIC so the
# rootfs needs no shared libs. musl-gcc pulls in the diet libc.
CONFIG_STATIC=y
CONFIG_PREFIX=""
# keep defconfig applets (vi, wget, httpd, udhcpc, awk, sed, tar, ip, ...)
# disable the genuinely heavy/loud extras:
# CONFIG_.* no via oldconfig defaults is fine; the tree stays < 2 MB static.
